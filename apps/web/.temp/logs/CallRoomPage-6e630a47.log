      type: "boolean",
      value: false,
      label: "Is Desktop App"
    }
  });

  // Set mock native window
  if (typeof window !== 'undefined') {
    window.nativeWindow = mockNativeWindow;
  }

  return (
    <ImportedComponent />
  );
}
</content>
</change>
