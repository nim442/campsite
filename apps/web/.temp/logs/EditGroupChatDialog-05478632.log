import { EditGroupChatDialog } from '../../components/Thread/EditGroupChatDialog';
import { ScopeProvider } from '../../contexts/scope';
import { QueryNormalizerProvider } from '../../utils/normy/QueryNormalizerProvider';
import { QueryClient } from '@tanstack/react-query';
import Image from 'next/image';

// Create a wrapper for Next.js Image that handles domain validation
const ImageWrapper = (props: any) => {
  return (
    // @ts-ignore - Force unoptimized images in preview
    <Image
      {...props}
      unoptimized={true}
      loader={({ src }: { src: string }) => src}
    />
  );
};

// Override the Next.js Image component for this preview
const originalImage = Image;
// @ts-ignore - Replace Image with wrapper
React.modules['next/image'].default = ImageWrapper;
