// Mock next/router module
const mockRouter = {
  query: { org: 'test-org' },
  isReady: true,
  asPath: '/test-org/settings',
  pathname: '/test-org/settings',
  route: '/test-org/settings',
  basePath: '',
  events: {
    on: () => {},
    off: () => {},
    emit: () => {}
  },
  push: () => Promise.resolve(true),
  replace: () => Promise.resolve(true),
  reload: () => {},
  back: () => {},
  prefetch: () => Promise.resolve(),
  beforePopState: () => {},
