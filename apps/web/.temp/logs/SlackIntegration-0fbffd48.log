    useGetSlackIntegration,
    useSlackBroadcastsAuthorizationUrl,
    useCurrentUserOrOrganizationHasFeature
  };

  return (
    <MockProviders>
      <SlackIntegration />
    </MockProviders>
  );
}
</content>
