          archived: false,
          message_thread_id: null
        },
        resolved: false
      },
      label: "Target"
    }
  });

  return (
    <QueryClientProvider client={queryClient}>
      <QueryNormalizerProvider queryClient={queryClient}>
        <ScopeProvider>
          <Detail target={state.target.value} />
        </ScopeProvider>
      </QueryNormalizerProvider>
