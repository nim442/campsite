import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { OrgAvatar } from '../../components/OrgOnboarding/Components';
import { useQuery } from '@tanstack/react-query';

// Create the contexts with proper types
const OrganizationContext = createContext<{
  useGetCurrentOrganization: typeof useGetCurrentOrganization;
} | null>(null);

const ScopeContext = createContext<{
  scope: string;
  setScope: (scope: string) => void;
} | undefined>(undefined);

export const OrganizationProvider = OrganizationContext.Provider;
export const ScopeProvider = ScopeContext.Provider;

// Create a mock useGetCurrentOrganization hook that matches the real one's interface
function useGetCurrentOrganization() {
  return useQuery({
    queryKey: ['currentOrganization'],
    queryFn: () => undefined,
    enabled: false
  });
}

export default function ComponentPreview() {
  const [state] = useParentState({
    orgName: {
      type: "string",
      value: "Sample Organization",
      label: "Organization Name"
    },
    avatarUrls: {
      type: "object",
      value: {
        small: "https://placekitten.com/50/50",
        medium: "https://placekitten.com/100/100",
        large: "https://placekitten.com/200/200"
      },
      label: "Avatar URLs"
    }
  });

  const mockOrg = {
    name: state.orgName.value,
    avatar_urls: state.avatarUrls.value
  };

  const mockUseGetCurrentOrganization = () => ({
    data: mockOrg,
    isLoading: false,
    error: null
  });

  const scopeValue = {
    scope: 'demo-org',
    setScope: () => {}
  };

  return (
    <ScopeProvider value={scopeValue}>
      <OrganizationProvider value={{ useGetCurrentOrganization: mockUseGetCurrentOrganization }}>
        <OrgAvatar />
      </OrganizationProvider>
    </ScopeProvider>
  );
}
</content>
</change>
</file>

