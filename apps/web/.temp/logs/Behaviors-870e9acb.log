import React from 'react';
import { useParentState } from '../useIframeState';
import { Behaviors } from '../../components/UserSettings/Behaviors';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create contexts to provide mock values
const CurrentUserContext = React.createContext(null);
const PreferenceContext = React.createContext(null);

// Mock data and functions
const mockCurrentUser = {
  preferences: {
    prefers_desktop_app: 'enabled'
  }
};

const mockUseGetCurrentUser = {
  data: mockCurrentUser
};

const mockUseUpdatePreference = {
  mutate: () => {},
  isPending: false
};

// Mock providers wrapper
const MockProviders = ({ children }) => {
  return (
    <CurrentUserContext.Provider value={mockUseGetCurrentUser}>
      <PreferenceContext.Provider value={mockUseUpdatePreference}>
        {children}
      </PreferenceContext.Provider>
    </CurrentUserContext.Provider>
  );
};

// Override the actual hooks
import * as hooks from '@/hooks/useGetCurrentUser';
import * as prefHooks from '@/hooks/useUpdatePreference';

// @ts-ignore - Overriding for preview
hooks.useGetCurrentUser = () => React.useContext(CurrentUserContext);
// @ts-ignore - Overriding for preview
prefHooks.useUpdatePreference = () => React.useContext(PreferenceContext);

const queryClient = new QueryClient();

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isEnabled: {
      type: "boolean",
      value: true,
      label: "Is Desktop App Enabled"
    }
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockProviders>
        <Behaviors />
      </MockProviders>
    </QueryClientProvider>
  );
}
</content>
  </change>
</file>

