export default function ComponentPreview() {
  const [state, setState] = useParentState({
    open: {
      type: "boolean",
      value: true,
      label: "Dialog Open State"
    }
  });

  // Create a mock router object that matches Next.js router shape
  const mockRouter = {
    query: { org: 'test-org' },
