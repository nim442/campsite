    beforePopState: () => {},
    events: {
      on: () => {},
      off: () => {},
      emit: () => {}
    },
    isFallback: false,
    isLocaleDomain: false,
    isPreview: false
  };

  return (
    <RouterContext.Provider value={mockRouter}>
      <ScopeProvider>
        <DeleteCampsiteDialog 
          open={state.open.value}
          onOpenChange={(open) => setState('open', open)}
        />
      </ScopeProvider>
    </RouterContext.Provider>
  );
}
