import React from 'react';
import { useParentState } from '../useIframeState';
import { DeleteCampsiteDialog } from '../../components/OrgSettings/DeleteCampsite/DeleteCampsiteDialog';
import { createContext, useContext } from 'react';

// Create a simplified version of the scope context
const SimpleScopeContext = createContext<{ scope: string; setScope: (scope: string) => void } | undefined>(undefined);

function SimpleScopeProvider({ children }: { children: React.ReactNode }) {
  const value = {
    scope: 'test-org',
    setScope: () => {}
  };
  
  return (
    <SimpleScopeContext.Provider value={value}>
      {children}
    </SimpleScopeContext.Provider>
  );
}

// Override the useScope hook
(global as any).useScope = () => {
  const context = useContext(SimpleScopeContext);
  if (!context) {
    throw new Error('useScope must be used within a ScopeProvider');
  }
  return context;
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    open: {
      type: "boolean",
      value: true,
      label: "Dialog Open State"
    }
  });

  return (
    <SimpleScopeProvider>
      <DeleteCampsiteDialog 
        open={state.open.value}
        onOpenChange={(open) => setState('open', open)}
      />
    </SimpleScopeProvider>
  );
}
</content>
</change>
</file>

