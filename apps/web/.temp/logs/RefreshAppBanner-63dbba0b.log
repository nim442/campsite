<content>
import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { RefreshAppBanner } from '../../components/NavigationSidebar/RefreshAppBanner';

// Create contexts for our mocked hooks
const HasLatestBuildContext = createContext<boolean>(false);
const StoredStateContext = createContext<[number | null, () => void]>([null, () => {}]);

// Create custom hook wrappers
export function useHasLatestBuild() {
  return useContext(HasLatestBuildContext);
}

export function useStoredState<T>() {
  return useContext(StoredStateContext) as [T, (value: T) => void];
}

// Mock Provider component
const MockProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const mockStoredState: [number | null, () => void] = [
    Date.now() - (1000 * 60 * 60 * 25), // More than 24 hours ago
    () => {}
  ];

  return (
    <HasLatestBuildContext.Provider value={false}>
      <StoredStateContext.Provider value={mockStoredState}>
        {children}
      </StoredStateContext.Provider>
    </HasLatestBuildContext.Provider>
  );
};

// Override the module imports
jest?.mock('@/hooks/useHasLatestBuild', () => ({
  useHasLatestBuild: () => useContext(HasLatestBuildContext)
}));

jest?.mock('@/hooks/useStoredState', () => ({
  useStoredState: () => useContext(StoredStateContext)
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isVisible: {
      type: "boolean",
      value: true,
      label: "Is Visible"
    }
  });

  return (
    <MockProvider>
      <RefreshAppBanner />
    </MockProvider>
  );
}
</content>
</change>
