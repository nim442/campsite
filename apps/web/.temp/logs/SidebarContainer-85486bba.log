    <RouterContext.Provider value={mockRouter as any}>
      <Provider>
        <ScopeProvider>
          <div className="h-screen w-screen">
            <SidebarContainer />
          </div>
        </ScopeProvider>
      </Provider>
    </RouterContext.Provider>
  );
}
</content>
