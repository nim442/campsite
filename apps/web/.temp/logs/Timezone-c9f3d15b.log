import React from 'react';
import { Timezone } from '../../components/UserSettings/Timezone';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create mock context
const CurrentUserContext = React.createContext<any>(null);
const TimezoneContext = React.createContext<any>(null);

// Create a wrapper component to provide the necessary context and mock data
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock data
const mockCurrentUser = {
  data: { timezone: 'America/New_York' }
};

const mockCreateTimezone = {
  mutate: (params: { timezone: string }, options: any) => {
    console.log('Timezone updated:', params.timezone);
    if (options?.onSuccess) {
      options.onSuccess();
    }
  }
};

// Create mock providers
const MockProviders: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  return (
    <QueryClientProvider client={queryClient}>
      <CurrentUserContext.Provider value={mockCurrentUser}>
        <TimezoneContext.Provider value={mockCreateTimezone}>
          {children}
        </TimezoneContext.Provider>
      </CurrentUserContext.Provider>
    </QueryClientProvider>
  );
};

// Override the hooks
import * as CurrentUserHook from '@/hooks/useGetCurrentUser';
import * as CreateTimezoneHook from '@/hooks/useCreateUserTimezone';

// @ts-ignore
CurrentUserHook.useGetCurrentUser = () => React.useContext(CurrentUserContext);
// @ts-ignore
CreateTimezoneHook.useCreateUserTimezone = () => React.useContext(TimezoneContext);

export default function ComponentPreview() {
  return (
    <MockProviders>
      <Timezone />
    </MockProviders>
  );
}
</content>
