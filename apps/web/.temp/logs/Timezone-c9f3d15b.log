import React from 'react';
import { Timezone } from '../../components/UserSettings/Timezone';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a wrapper component to provide the necessary context and mock data
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Set up the mock data in the query client
queryClient.setQueryData(['currentUser'], {
  timezone: 'America/New_York',
});

export default function ComponentPreview() {
  // Override the hooks at runtime
  const originalUseGetCurrentUser = require('@/hooks/useGetCurrentUser').useGetCurrentUser;
  const originalUseCreateUserTimezone = require('@/hooks/useCreateUserTimezone').useCreateUserTimezone;

  // Override the hooks with mock implementations
  require('@/hooks/useGetCurrentUser').useGetCurrentUser = () => ({
    data: { timezone: 'America/New_York' }
  });

  require('@/hooks/useCreateUserTimezone').useCreateUserTimezone = () => ({
    mutate: (params: { timezone: string }, options: any) => {
      console.log('Timezone updated:', params.timezone);
      if (options?.onSuccess) {
        options.onSuccess();
      }
    }
  });

  return (
    <QueryClientProvider client={queryClient}>
      <Timezone />
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

