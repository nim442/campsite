  events: {
    on: () => {},
    off: () => {},
    emit: () => {}
  },
  isFallback: false,
  isLocaleDomain: false,
  isPreview: false
});

// Mock the useRouter hook
React.createContext = (defaultValue) => {
  if (defaultValue && 'pathname' in defaultValue) {
    return MockRouterContext;
