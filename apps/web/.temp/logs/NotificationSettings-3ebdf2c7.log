import React from 'react';
import { useParentState } from '../useIframeState';
import { NotificationSettings } from '../../components/UserSettings/Notifications/NotificationSettings';
import * as SettingsSection from 'components/SettingsSection';

export default function ComponentPreview() {
  // Since this component doesn't take any props and uses hooks internally,
  // we just need to render it directly. However, we'll need to mock the
  // context and data it expects.

  // Mock the query hooks results
  const mockNotifications = [
    {
      id: '1',
      name: 'weekly_digest',
      time_zone: 'America/Los_Angeles',
    }
  ];

  // Mock the hooks
  const useGetCurrentUserNotifications = () => ({
    data: mockNotifications,
    isLoading: false,
  });

  const useUpdateScheduledNotification = () => ({
    mutate: async (data: any) => {
      console.log('Updating notification:', data);
      return Promise.resolve(data);
    }
  });

  // Override the hooks
  (global as any).useGetCurrentUserNotifications = useGetCurrentUserNotifications;
  (global as any).useUpdateScheduledNotification = useUpdateScheduledNotification;

  return (
    <SettingsSection.Provider>
      <NotificationSettings />
    </SettingsSection.Provider>
  );
}
