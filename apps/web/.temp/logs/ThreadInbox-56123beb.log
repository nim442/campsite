  query: { org: 'test-org', threadId: '1' },
  push: () => Promise.resolve(true),
  pathname: '',
  asPath: '/test-org/chat',
  basePath: '',
  route: '',
  events: {
    on: () => {},
    off: () => {},
  },
  isFallback: false,
  isLocaleDomain: false,
  isReady: true,
  isPreview: false,
};

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Prefetch the mock data
