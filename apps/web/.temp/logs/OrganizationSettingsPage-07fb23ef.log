import React from 'react';
import { useParentState } from '../useIframeState';
import ImportedComponent from '../../pages/[org]/settings/index';
import AuthAppProviders from '@/components/Providers/AuthAppProviders';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a mock hooks module
const createMockHooks = (state: any) => ({
  useGetCurrentOrganization: () => ({
    data: {
      name: state.organizationName.value,
      id: "test-org-id"
    }
  }),
  useViewerIsAdmin: () => state.isAdmin.value
});

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    organizationName: {
      type: "string",
      value: "Test Organization",
      label: "Organization Name"
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin"
    }
  });

  // Create a new QueryClient instance
  const queryClient = React.useMemo(() => new QueryClient({
    defaultOptions: {
      queries: {
        retry: false,
        refetchOnWindowFocus: false,
      },
    },
  }), []);

  // Create mock hooks
  const hooks = React.useMemo(() => createMockHooks(state), [state]);

  // Override the hooks
  React.useEffect(() => {
    const originalModule = require('@/hooks/useGetCurrentOrganization');
    const originalViewerModule = require('@/hooks/useViewerIsAdmin');

    // Save original implementations
    const original = {
      useGetCurrentOrganization: originalModule.useGetCurrentOrganization,
      useViewerIsAdmin: originalViewerModule.useViewerIsAdmin
    };

    // Override with mocks
    originalModule.useGetCurrentOrganization = hooks.useGetCurrentOrganization;
    originalViewerModule.useViewerIsAdmin = hooks.useViewerIsAdmin;

    return () => {
      // Restore original implementations
      originalModule.useGetCurrentOrganization = original.useGetCurrentOrganization;
      originalViewerModule.useViewerIsAdmin = original.useViewerIsAdmin;
    };
  }, [hooks]);

  return (
    <QueryClientProvider client={queryClient}>
      <AuthAppProviders allowLoggedOut={true}>
        <ImportedComponent />
      </AuthAppProviders>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

