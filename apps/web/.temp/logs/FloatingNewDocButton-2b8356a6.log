    useGetCurrentOrganization: window.__mocks.useGetCurrentOrganization,
  },
  '@/hooks/useCreateNote': {
    useCreateNewNote: window.__mocks.useCreateNewNote,
  },
};

// Override import.meta.hot
window.__vite_hot = {
  accept: () => {},
  dispose: () => {},
  invalidate: () => {},
  decline: () => {},
  on: () => {},
  send: () => {},
};

export default function ComponentPreview() {
  return (
    <QueryClientProvider client={queryClient}>
      <ThemeProvider attribute="class">
        <FloatingNewDocButton />
      </ThemeProvider>
