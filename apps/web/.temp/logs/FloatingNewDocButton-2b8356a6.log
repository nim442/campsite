import React, { createContext, useContext } from 'react';
import { FloatingNewDocButton } from '../../components/FloatingButtons/NewDoc';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ThemeProvider } from 'next-themes';

// Create a new QueryClient instance
const queryClient = new QueryClient();

// Create contexts for our mocked values
const RouterContext = createContext(null);
const OrganizationContext = createContext(null);
const CreateNoteContext = createContext(null);

// Create mock values
const mockRouter = {
  query: { projectId: '123' },
  push: () => Promise.resolve(true),
  pathname: '/',
};

const mockOrganization = {
  data: {
    viewer_can_post: true,
  },
};

const mockCreateNote = {
  handleCreate: () => {},
  isPending: false,
};

// Create mock hooks that use our contexts
const useRouter = () => useContext(RouterContext);
const useGetCurrentOrganization = () => useContext(OrganizationContext);
const useCreateNewNote = () => useContext(CreateNoteContext);

// Create a wrapper component that provides all the mocked values
function MockProvider({ children }) {
  return (
    <QueryClientProvider client={queryClient}>
      <ThemeProvider attribute="class">
        <RouterContext.Provider value={mockRouter}>
          <OrganizationContext.Provider value={mockOrganization}>
            <CreateNoteContext.Provider value={mockCreateNote}>
              {children}
            </CreateNoteContext.Provider>
          </OrganizationContext.Provider>
        </RouterContext.Provider>
      </ThemeProvider>
    </QueryClientProvider>
  );
}

// Override the hooks in the component's scope
window.useRouter = useRouter;
window.useGetCurrentOrganization = useGetCurrentOrganization;
window.useCreateNewNote = useCreateNewNote;
window.isMobile = false;

export default function ComponentPreview() {
  return (
    <MockProvider>
      <FloatingNewDocButton />
    </MockProvider>
  );
}
