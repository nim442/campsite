import React from 'react';
import { FloatingNewDocButton } from '../../components/FloatingButtons/NewDoc';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ThemeProvider } from 'next-themes';
import { RouterContext } from 'next/dist/shared/lib/router-context';

// Create a new QueryClient instance
const queryClient = new QueryClient();

// Mock router context value
const mockRouterContextValue = {
  query: { projectId: '123' },
  push: () => Promise.resolve(true),
  pathname: '/',
  route: '/',
  asPath: '/',
  basePath: '',
  isLocaleDomain: false,
  isPreview: false,
  isReady: true,
  events: {
    on: () => {},
    off: () => {},
    emit: () => {},
  },
  isFallback: false,
  locale: 'en',
  locales: ['en'],
  defaultLocale: 'en',
};

// Create a wrapper component that provides all necessary context
function PreviewWrapper({ children }) {
  return (
    <QueryClientProvider client={queryClient}>
      <ThemeProvider attribute="class">
        <RouterContext.Provider value={mockRouterContextValue}>
          {children}
        </RouterContext.Provider>
      </ThemeProvider>
    </QueryClientProvider>
  );
}

// Mock isMobile
globalThis.isMobile = false;

// Create a HOC to inject mock hooks
function withMockHooks(Component) {
  return function WrappedComponent(props) {
    // Mock the hooks
    const mockRouter = {
      query: { projectId: '123' },
      push: () => Promise.resolve(true),
      pathname: '/',
    };

    const mockCurrentOrganization = {
      data: {
        viewer_can_post: true,
      },
    };

    const mockCreateNote = {
      handleCreate: () => {},
      isPending: false,
    };

    // Override the hooks in the component's scope
    const useRouter = () => mockRouter;
    const useGetCurrentOrganization = () => mockCurrentOrganization;
    const useCreateNewNote = () => mockCreateNote;

    return <Component {...props} />;
  };
}

const FloatingNewDocButtonWithMocks = withMockHooks(FloatingNewDocButton);

export default function ComponentPreview() {
  return (
    <PreviewWrapper>
      <FloatingNewDocButtonWithMocks />
    </PreviewWrapper>
  );
}
