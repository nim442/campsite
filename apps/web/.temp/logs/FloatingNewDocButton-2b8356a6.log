import React from 'react';
import { FloatingNewDocButton } from '../../components/FloatingButtons/NewDoc';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ThemeProvider } from 'next-themes';

// Create a new QueryClient instance
const queryClient = new QueryClient();

// Mock values
const mockRouter = {
  query: { projectId: '123' },
  push: () => Promise.resolve(true),
  pathname: '/',
};

// Mock the modules
const mockModules = {
  'next/router': {
    useRouter: () => mockRouter
  },
  '@/hooks/useGetCurrentOrganization': {
    useGetCurrentOrganization: () => ({
      data: {
        viewer_can_post: true,
      },
    })
  },
  '@/hooks/useCreateNote': {
    useCreateNewNote: () => ({
      handleCreate: () => {},
      isPending: false,
    })
  },
  'react-device-detect': {
    isMobile: false
  }
};

// Set up the mock system
const originalRequire = window.require;
window.require = (moduleName) => {
  if (mockModules[moduleName]) {
    return mockModules[moduleName];
  }
  return originalRequire?.(moduleName);
};

export default function ComponentPreview() {
  return (
    <QueryClientProvider client={queryClient}>
      <ThemeProvider attribute="class">
        <FloatingNewDocButton />
      </ThemeProvider>
    </QueryClientProvider>
  );
}
</content>
