  replace: () => Promise.resolve(true),
  reload: () => {},
  back: () => {},
  beforePopState: () => true,
  forward: () => {}
};

// Override the useRouter implementation
const RouterContext = React.createContext<Partial<NextRouter>>(mockRouter);

export default function ComponentPreview() {
  const pageProps = {
    session: {
      user: {
        id: '123',
        name: 'Test User',
