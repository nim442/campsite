import React from 'react';
import { useParentState } from '../useIframeState';
import { LinkAttachmentStatic } from '../../components/Thread/Bubble/AttachmentCard/LinkAttachmentStatic';
import Image from 'next/image';

// Create a wrapper for Next.js Image that allows all domains
const ImageWrapper = (props: any) => {
  const { src, ...rest } = props;
  
  // Convert the src to a base64 string if it's an external URL
  if (src.startsWith('http')) {
    return <img {...rest} src={src} />;
  }
  
  return <Image {...props} />;
};

// Override the Next.js Image component
React.modules = {
  ...React.modules,
  'next/image': ImageWrapper
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
