import { createContext, useContext, useMemo } from 'react';

// Create a simplified version of the ScopeContext for preview
const ScopeContext = createContext<{ scope: string; setScope: (scope: string) => void } | undefined>(undefined);

function PreviewScopeProvider({ children }: { children: React.ReactNode }) {
  const value = useMemo(() => ({
    scope: 'test-org',
    setScope: (scope: string) => console.log('setScope', scope)
  }), []);

  return <ScopeContext.Provider value={value}>{children}</ScopeContext.Provider>;
}

