import React from 'react';
import { Provider as JotaiProvider } from 'jotai';
import { NewPostButton } from '../../components/Sidebar/NewPostButton';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ScopeProvider } from '../../contexts/scope';

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

export default function ComponentPreview() {
  // Mock Next.js router context that ScopeProvider expects
  const mockRouter = {
    query: { org: 'demo-org' },
    isReady: true,
    asPath: '/demo-org/posts'
  };

  // @ts-ignore - We're mocking the router context
  global.Router = {
    asPath: '/demo-org/posts'
  };

  return (
    <JotaiProvider>
      <QueryClientProvider client={queryClient}>
        {/* @ts-ignore - We're providing minimal router context */}
        <ScopeProvider router={mockRouter}>
          <NewPostButton />
        </ScopeProvider>
      </QueryClientProvider>
    </JotaiProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Added the `ScopeProvider` import
2. Added the `ScopeProvider` component to the component tree
3. Provided a mock router context that the `ScopeProvider` expects
4. Set up a basic scope ('demo-org') that the component can use

This should resolve the `useScope` error while maintaining the exact functionality of the component. The component will still look and behave exactly as it does in the main codebase, we're just providing the necessary context it needs to function.

The changes maintain the original component's functionality while providing the required context for it to work properly. We're not modifying the actual component, just setting up its required environment.

