  route: '/',
  pathname: '/',
  query: { org: 'test-org' },
  asPath: '/',
  basePath: '',
  isReady: true,
  push: () => Promise.resolve(true),
  replace: () => Promise.resolve(true),
  reload: () => {},
  back: () => {},
  forward: () => {},
