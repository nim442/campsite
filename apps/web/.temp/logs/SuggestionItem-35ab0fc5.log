    value: {
      type: "string",
      value: "suggestion-item",
      label: "Value"
    },
    keywords: {
      type: "object",
      value: ["keyword1", "keyword2"],
      label: "Keywords"
    },
    forceMount: {
      type: "boolean",
      value: false,
      label: "Force Mount"
    },
    disableOnClick: {
      type: "boolean",
      value: false,
      label: "Disable onClick"
    },
    scoreModifier: {
      type: "number",
      value: 1,
      label: "Score Modifier"
    }
  });

  // Mock editor instance
  const mockEditor = {
    commands: {
      focus: () => {}
    }
  } as Editor;

  // Mock range
