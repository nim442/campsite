import React from 'react';
import { useParentState } from '../useIframeState';
import { useHandleCommandListSubjectSelect } from '../../components/Projects/hooks/useHandleHighlightedItemSelect';
import { Provider } from 'jotai';
import { ScopeProvider } from '../../contexts/scope';

// Mock Next.js
const mockRouter = {
  route: '/[org]/projects',
  pathname: '/[org]/projects',
  query: { org: 'test-org' },
  asPath: '/test-org/projects',
  basePath: '',
  isReady: true,
  isFallback: false,
  push: () => Promise.resolve(true),
  replace: () => Promise.resolve(true),
  reload: () => {},
  back: () => {},
  prefetch: () => Promise.resolve(),
  beforePopState: () => {},
  events: {
    on: () => {},
    off: () => {},
    emit: () => {}
  }
};

// Mock Next.js router
jest.mock('next/router', () => ({
  useRouter: () => mockRouter
}));

// Mock cookies-next
jest.mock('cookies-next', () => ({
  setCookie: () => {},
  getCookie: () => 'test-org'
}));

const MockRouterProvider = ({ children }: { children: React.ReactNode }) => {
  return React.createElement(
    React.createContext({}).Provider,
    { value: mockRouter },
    children
  );
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    sampleValue: {
      type: "string",
      value: "sample-subject",
      label: "Subject Value"
    }
  });

  // Override the router for the entire app
  React.useEffect(() => {
    const originalUseRouter = require('next/router').useRouter;
    require('next/router').useRouter = () => mockRouter;
    return () => {
      require('next/router').useRouter = originalUseRouter;
    };
  }, []);

  const { handleSelect } = useHandleCommandListSubjectSelect();

  return (
    <MockRouterProvider>
      <ScopeProvider>
        <Provider>
          <div onClick={(e) => handleSelect(state.sampleValue.value, e)}>
            Click to test subject selection
          </div>
        </Provider>
      </ScopeProvider>
    </MockRouterProvider>
  );
}

// Set up Next.js data
if (typeof window !== 'undefined') {
  // @ts-ignore
  window.__NEXT_DATA__ = {
    props: {
      pageProps: {}
    },
    page: '/[org]/projects',
    query: { org: 'test-org' },
    buildId: 'development'
  };
}
</content>
</change>
</file>

