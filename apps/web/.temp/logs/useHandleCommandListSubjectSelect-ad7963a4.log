import React from 'react';
import { useParentState } from '../useIframeState';
import { useHandleCommandListSubjectSelect } from '../../components/Projects/hooks/useHandleHighlightedItemSelect';
import { Provider } from 'jotai';
import { ScopeProvider } from '../../contexts/scope';

// Create a mock router context
const NextRouterContext = React.createContext(null);
NextRouterContext.displayName = 'RouterContext';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    sampleValue: {
      type: "string",
      value: "sample-subject",
      label: "Subject Value"
    }
  });

  const mockRouter = React.useMemo(() => ({
    route: '/[org]/projects',
    pathname: '/[org]/projects',
    query: { org: 'test-org' },
    asPath: '/test-org/projects',
    basePath: '',
    isReady: true,
    isFallback: false,
    push: () => Promise.resolve(true),
    replace: () => Promise.resolve(true),
    reload: () => {},
    back: () => {},
    prefetch: () => Promise.resolve(),
    beforePopState: () => {},
    events: {
      on: () => {},
      off: () => {},
      emit: () => {}
    },
    isLocaleDomain: false,
    isPreview: false,
    defaultLocale: 'en',
    domainLocales: [],
    locale: 'en'
  }), []);

  const { handleSelect } = useHandleCommandListSubjectSelect();

  return (
    <NextRouterContext.Provider value={mockRouter}>
      <ScopeProvider>
        <Provider>
          <div onClick={(e) => handleSelect(state.sampleValue.value, e)}>
            Click to test subject selection
          </div>
        </Provider>
      </ScopeProvider>
    </NextRouterContext.Provider>
  );
}

// Override Next.js router module
if (typeof window !== 'undefined') {
  // @ts-ignore
  window.__NEXT_DATA__ = {
    props: {
      pageProps: {}
    },
    page: '/[org]/projects',
    query: { org: 'test-org' },
    buildId: 'development'
  };
}
</content>
</change>
</file>

