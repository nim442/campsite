import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { HeadOrgName } from '../../components/OrgOnboarding/Components';
import { Organization } from '@campsite/types';

// Create mock contexts
const OrganizationContext = createContext<{ data: Organization | null }>({ data: null });
const ScopeContext = createContext<{ scope: string; setScope: (scope: string) => void } | undefined>(undefined);

// Mock hooks
const useGetCurrentOrganization = () => useContext(OrganizationContext);

// Mock ScopeProvider
const ScopeProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const value = {
    scope: "sample-org",
    setScope: (scope: string) => {}
  };
  
  return (
    <ScopeContext.Provider value={value}>
      {children}
    </ScopeContext.Provider>
  );
};

// Mock OrganizationProvider
const OrganizationProvider: React.FC<{ initialData: Organization; children: React.ReactNode }> = ({ 
  initialData,
  children 
}) => {
  return (
    <OrganizationContext.Provider value={{ data: initialData }}>
      {children}
    </OrganizationContext.Provider>
  );
};

export default function ComponentPreview() {
  const mockOrg = {
    name: "Sample Organization",
    avatar_urls: ["https://placekitten.com/200/200"],
    id: "1",
    slug: "sample-org",
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString()
  };

  return (
    <ScopeProvider>
      <OrganizationProvider initialData={mockOrg}>
        <HeadOrgName />
      </OrganizationProvider>
    </ScopeProvider>
  );
}
</content>
