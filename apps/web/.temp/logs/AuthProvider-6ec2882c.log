    replace: () => Promise.resolve(true),
    reload: () => {},
    back: () => {},
    prefetch: () => Promise.resolve(),
    beforePopState: () => {},
    isFallback: false
  };

  return <routerContext.Provider value={mockRouter}>{children}</routerContext.Provider>;
};

// Override the useRouter implementation for our preview
