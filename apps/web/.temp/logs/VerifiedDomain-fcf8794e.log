import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import { ScopeContext } from '@/contexts/scope';
import type { CookieValueTypes } from 'cookies-next';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create a simplified scope provider that uses the actual context
function SimplifiedScopeProvider({ children }: { children: React.ReactNode }) {
  const value = React.useMemo(() => ({
    scope: 'test-org' as CookieValueTypes,
    setScope: (scope: CookieValueTypes) => {}
  }), []);

  return <ScopeContext.Provider value={value}>{children}</ScopeContext.Provider>;
}

// Mock hooks
function useGetCurrentOrganization() {
  return { data: mockCurrentOrg };
}

function useGetCurrentUser() {
  return { data: mockCurrentUser };
}

function useViewerIsAdmin() {
  return true;
}

function useUpdateOrganization() {
  return {
    mutate: (data: any, options: any) => {
      if (options?.onSuccess) {
        options.onSuccess();
      }
    },
    isPending: false,
  };
}

// Mock the modules
jest.mock('@/hooks/useGetCurrentOrganization', () => ({
  useGetCurrentOrganization
}));

jest.mock('@/hooks/useGetCurrentUser', () => ({
  useGetCurrentUser
}));

jest.mock('@/hooks/useViewerIsAdmin', () => ({
  useViewerIsAdmin
}));

jest.mock('hooks/useUpdateOrganization', () => ({
  useUpdateOrganization
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <SimplifiedScopeProvider>
        <VerifiedDomain />
      </SimplifiedScopeProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
