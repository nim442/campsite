<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import type { CookieValueTypes } from 'cookies-next';

// Create virtual modules before any imports
const virtualModules = {
  '@/contexts/scope': {
    useScope: () => ({ scope: 'test-org', setScope: () => {} })
  },
  '@/hooks/useGetCurrentOrganization': {
    useGetCurrentOrganization: () => ({
      data: { email_domain: 'example.com' }
    })
  },
  '@/hooks/useGetCurrentUser': {
    useGetCurrentUser: () => ({
      data: { email: 'user@example.com' }
    })
  },
  '@/hooks/useViewerIsAdmin': {
    useViewerIsAdmin: () => true
  },
  'hooks/useUpdateOrganization': {
    useUpdateOrganization: () => ({
      mutate: (data: any, options: any) => {
        if (options?.onSuccess) {
          options.onSuccess();
        }
      },
      isPending: false
    })
  }
};

// Register virtual modules
Object.entries(virtualModules).forEach(([path, module]) => {
  // @ts-ignore
  window.__vite__register(path, module);
});

// Create a new QueryClient
const queryClient = new QueryClient({
