import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Import the actual context from the codebase
import { ScopeContext } from '@/contexts/scope';

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create a simplified ScopeProvider that provides the necessary context
function SimplifiedScopeProvider({ children }: { children: React.ReactNode }) {
  const [scope, setScope] = React.useState('test-org');
  const value = React.useMemo(() => ({
    scope,
    setScope
  }), [scope]);

  return (
    <ScopeContext.Provider value={value}>
      {children}
    </ScopeContext.Provider>
  );
}

// Create wrapper component that provides all necessary context and mocked data
function PreviewWrapper({ children }: { children: React.ReactNode }) {
  // Mock the hooks
  const useGetCurrentOrganization = () => ({ data: mockCurrentOrg });
  const useGetCurrentUser = () => ({ data: mockCurrentUser });
  const useViewerIsAdmin = () => true;
  const useUpdateOrganization = () => ({
    mutate: (data: any, options: any) => {
      if (options?.onSuccess) {
        options.onSuccess();
      }
    },
    isPending: false,
  });

  // Override the hooks
  React.useEffect(() => {
    const hooks = {
      '@/hooks/useGetCurrentOrganization': { useGetCurrentOrganization },
      '@/hooks/useGetCurrentUser': { useGetCurrentUser },
      '@/hooks/useViewerIsAdmin': { useViewerIsAdmin },
      'hooks/useUpdateOrganization': { useUpdateOrganization }
    };

    // @ts-ignore
    window.__PREVIEW_HOOKS__ = hooks;
  }, []);

  return (
    <QueryClientProvider client={queryClient}>
      <SimplifiedScopeProvider>
        {children}
      </SimplifiedScopeProvider>
    </QueryClientProvider>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <PreviewWrapper>
      <VerifiedDomain />
    </PreviewWrapper>
  );
}
</content>
