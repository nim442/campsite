import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import type { CookieValueTypes } from 'cookies-next';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create a context for our mocked hooks and scope
const MockContext = React.createContext<any>(null);

// Create a provider component that provides all mocked functionality
function MockProvider({ children }: { children: React.ReactNode }) {
  const mockScope = React.useMemo(() => ({
    scope: 'test-org' as CookieValueTypes,
    setScope: () => {}
  }), []);

  const mockHooks = React.useMemo(() => ({
    useGetCurrentOrganization: () => ({ data: mockCurrentOrg }),
    useGetCurrentUser: () => ({ data: mockCurrentUser }),
    useViewerIsAdmin: () => true,
    useUpdateOrganization: () => ({
      mutate: (data: any, options: any) => {
        if (options?.onSuccess) {
          options.onSuccess();
        }
      },
      isPending: false
    }),
    useScope: () => mockScope
  }), [mockScope]);

  return (
    <MockContext.Provider value={mockHooks}>
      {children}
    </MockContext.Provider>
  );
}

// Create a HOC that injects the mocked hooks
const withMockHooks = (WrappedComponent: React.ComponentType) => {
  return function WithMockHooksComponent(props: any) {
    const mockHooks = React.useContext(MockContext);

    // Create proxy component that injects hooks
    const ProxyComponent = React.useMemo(() => {
      const handler = {
        get: function(target: any, prop: string) {
          if (prop in mockHooks) {
            return mockHooks[prop];
          }
          return target[prop];
        }
      };

      // Create proxy for the component's module
      const moduleProxy = new Proxy({}, handler);
      
      // Override the imports in the component's scope
      const ComponentWithMocks = () => {
        Object.defineProperty(window, '__preview_module_proxy__', {
          value: moduleProxy,
          configurable: true
        });
        return <WrappedComponent {...props} />;
      };

      return ComponentWithMocks;
    }, [props]);

    return <ProxyComponent />;
  };
};

const VerifiedDomainWithMocks = withMockHooks(VerifiedDomain);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockProvider>
        <VerifiedDomainWithMocks />
      </MockProvider>
    </QueryClientProvider>
