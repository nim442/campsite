import React, { Suspense } from 'react';
import { useParentState } from '../useIframeState';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data and hooks
const mockData = {
  currentOrg: {
    email_domain: 'example.com',
  },
  currentUser: {
    email: 'user@example.com',
  },
  scope: 'test-org'
};

// Create a context for our mock scope
const MockScopeContext = React.createContext({
  scope: mockData.scope,
  setScope: (scope: string) => {}
});

const useMockScope = () => React.useContext(MockScopeContext);

// Create the preview component
export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  const VerifiedDomainWithMocks = React.useMemo(() => {
    // Import the component dynamically
    const VerifiedDomain = React.lazy(() => import('../../components/OrgSettings/VerifiedDomain').then(module => {
      // Mock the hooks before returning the component
      (global as any).useGetCurrentOrganization = () => ({ data: mockData.currentOrg });
      (global as any).useGetCurrentUser = () => ({ data: mockData.currentUser });
      (global as any).useViewerIsAdmin = () => true;
      (global as any).useUpdateOrganization = () => ({
        mutate: async (data: any, options: any) => {
          if (options?.onSuccess) {
            options.onSuccess();
          }
        },
        isPending: false
      });
      (global as any).useScope = useMockScope;
      
      return { default: module.VerifiedDomain };
    }));

    return VerifiedDomain;
  }, []);

  return (
    <QueryClientProvider client={queryClient}>
      <MockScopeContext.Provider value={{
        scope: mockData.scope,
        setScope: () => {}
      }}>
        <Suspense fallback={<div>Loading...</div>}>
          <VerifiedDomainWithMocks />
        </Suspense>
      </MockScopeContext.Provider>
    </QueryClientProvider>
  );
}
</content>
</change>
