import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import { ScopeContext } from '@/contexts/scope';
import type { CookieValueTypes } from 'cookies-next';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create a HOC that provides the scope context
const withScope = (WrappedComponent: React.ComponentType) => {
  return function WithScopeComponent(props: any) {
    const scopeValue = React.useMemo(() => ({
      scope: 'test-org' as CookieValueTypes,
      setScope: (scope: CookieValueTypes) => {}
    }), []);

    return (
      <ScopeContext.Provider value={scopeValue}>
        <WrappedComponent {...props} />
      </ScopeContext.Provider>
    );
  };
};

// Create a HOC that provides all the necessary hooks
const withHooks = (WrappedComponent: React.ComponentType) => {
  return function WithHooksComponent(props: any) {
    // Mock the hooks in the component's scope
    (global as any).useGetCurrentOrganization = () => ({ data: mockCurrentOrg });
    (global as any).useGetCurrentUser = () => ({ data: mockCurrentUser });
    (global as any).useViewerIsAdmin = () => true;
    (global as any).useUpdateOrganization = () => ({
      mutate: (data: any, options: any) => {
        if (options?.onSuccess) {
          options.onSuccess();
        }
      },
      isPending: false,
    });

    return <WrappedComponent {...props} />;
  };
};

// Combine the HOCs
const VerifiedDomainWithContext = withScope(withHooks(VerifiedDomain));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <VerifiedDomainWithContext />
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

