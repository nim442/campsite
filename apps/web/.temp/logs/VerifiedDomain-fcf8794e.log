const mockData = {
  currentOrg: {
    email_domain: 'example.com',
  },
  currentUser: {
    email: 'user@example.com',
  },
  scope: 'test-org'
};

// Create a context for our mock scope
const MockScopeContext = React.createContext<{
  scope: CookieValueTypes;
  setScope: (scope: CookieValueTypes) => void;
}>({
  scope: mockData.scope as CookieValueTypes,
  setScope: () => {}
});

// Create the preview component
export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  const VerifiedDomainWithMocks = React.useMemo(() => {
    // Import the component dynamically
    const VerifiedDomain = React.lazy(() => {
      // Mock the modules before importing
      (window as any).__vite__mockModules = {
        '@/contexts/scope': {
          useScope: () => React.useContext(MockScopeContext)
        },
        '@/hooks/useGetCurrentOrganization': {
