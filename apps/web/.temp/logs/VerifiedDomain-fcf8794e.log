            mutate: async (data: any, options: any) => {
              if (options?.onSuccess) {
                options.onSuccess();
              }
            },
            isPending: false
          })
        }
      };

      return import('../../components/OrgSettings/VerifiedDomain');
    });

    return VerifiedDomain;
  }, []);

  return (
