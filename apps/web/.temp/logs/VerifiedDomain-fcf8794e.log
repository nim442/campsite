<change>
<description>Create matching scope context implementation</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import type { CookieValueTypes } from 'cookies-next';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create a matching scope context implementation
interface State {
  scope: CookieValueTypes | undefined;
  setScope: (scope: CookieValueTypes) => void;
}

const MockScopeContext = React.createContext<State | undefined>(undefined);

function MockScopeProvider({ children }: { children: React.ReactNode }) {
  const [scope, setScope] = React.useState<CookieValueTypes>('test-org');
  const value = React.useMemo(() => ({ scope, setScope }), [scope]);
  return <MockScopeContext.Provider value={value}>{children}</MockScopeContext.Provider>;
}

// Mock the useScope hook
function useMockScope() {
  const context = React.useContext(MockScopeContext);
  if (context === undefined) {
    throw new Error('useScope must be used within a ScopeProvider');
  }
  return context;
}

// Override the module imports
const originalRequire = (window as any).require;
(window as any).require = function(path: string) {
  if (path === '@/contexts/scope') {
    return {
      useScope: useMockScope
    };
  }
  if (path === '@/hooks/useGetCurrentOrganization') {
    return {
      useGetCurrentOrganization: () => ({ data: mockCurrentOrg })
    };
  }
  if (path === '@/hooks/useGetCurrentUser') {
    return {
      useGetCurrentUser: () => ({ data: mockCurrentUser })
    };
  }
  if (path === '@/hooks/useViewerIsAdmin') {
    return {
      useViewerIsAdmin: () => true
    };
  }
  if (path === 'hooks/useUpdateOrganization') {
    return {
      useUpdateOrganization: () => ({
        mutate: (data: any, options: any) => {
          if (options?.onSuccess) {
            options.onSuccess();
          }
        },
        isPending: false
      })
    };
  }
  return originalRequire?.(path);
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockScopeProvider>
        <VerifiedDomain />
      </MockScopeProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

