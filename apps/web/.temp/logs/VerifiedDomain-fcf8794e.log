<description>Create mock hooks without modifying imported modules</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import * as SettingsSection from 'components/SettingsSection';
import toast from 'react-hot-toast';
import { ScopeProvider } from '@/contexts/scope';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Mock hooks
export const useGetCurrentOrganization = () => ({
  data: mockCurrentOrg,
});

export const useGetCurrentUser = () => ({
  data: mockCurrentUser,
});

export const useViewerIsAdmin = () => true;

export const useUpdateOrganization = () => ({
  mutate: async (data: any, options: any) => {
    if (options?.onSuccess) {
      options.onSuccess();
    }
  },
  isPending: false,
});

// Mock Next.js router
const mockRouter = {
  query: { org: 'test-org' },
  asPath: '/test-org/settings',
  isReady: true,
  push: () => Promise.resolve(true),
  prefetch: () => Promise.resolve(),
  replace: () => Promise.resolve(true),
};

// Create a custom scope provider that doesn't depend on Next.js router
const CustomScopeProvider = ({ children }: { children: React.ReactNode }) => {
  const [scope, setScope] = React.useState('test-org');
  const value = React.useMemo(() => ({
    scope,
    setScope: (newScope: string) => {
      setScope(newScope);
    }
  }), [scope]);

  return React.createElement(React.Fragment, null, children);
};

// Mock the modules
const mockModules = {
  '@/hooks/useGetCurrentOrganization': { useGetCurrentOrganization },
  '@/hooks/useGetCurrentUser': { useGetCurrentUser },
  '@/hooks/useViewerIsAdmin': { useViewerIsAdmin },
  'hooks/useUpdateOrganization': { useUpdateOrganization },
  '@/contexts/scope': { ScopeProvider: CustomScopeProvider, useScope: () => ({ scope: 'test-org', setScope: () => {} }) }
};

// Override module resolution
const originalRequire = window.require;
window.require = function(modulePath: string) {
  return mockModules[modulePath] || originalRequire(modulePath);
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <CustomScopeProvider>
        <VerifiedDomain />
      </CustomScopeProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

