import React, { createContext, useContext } from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import toast from 'react-hot-toast';
import type { CookieValueTypes } from 'cookies-next';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Create the scope context
interface ScopeState {
  scope: CookieValueTypes | undefined;
  setScope: (scope: CookieValueTypes) => void;
}

const ScopeContext = createContext<ScopeState | undefined>(undefined);

// Create the ScopeProvider component
function ScopeProvider({ children }: { children: React.ReactNode }) {
  const value = React.useMemo(() => ({
    scope: 'test-org' as CookieValueTypes,
    setScope: () => {}
  }), []);

  return <ScopeContext.Provider value={value}>{children}</ScopeContext.Provider>;
}

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Mock hooks
export function useGetCurrentOrganization() {
  return { data: mockCurrentOrg };
}

export function useGetCurrentUser() {
  return { data: mockCurrentUser };
}

export function useViewerIsAdmin() {
  return true;
}

export function useUpdateOrganization() {
  return {
    mutate: (data: any, options: any) => {
      if (options?.onSuccess) {
        options.onSuccess();
      }
    },
    isPending: false,
  };
}

// Override module imports
const mockModules = {
  '@/hooks/useGetCurrentOrganization': { useGetCurrentOrganization },
  '@/hooks/useGetCurrentUser': { useGetCurrentUser },
  '@/hooks/useViewerIsAdmin': { useViewerIsAdmin },
  'hooks/useUpdateOrganization': { useUpdateOrganization },
  '@/contexts/scope': { useScope: () => ({ scope: 'test-org', setScope: () => {} }) }
};

// @ts-ignore
if (typeof window !== 'undefined') {
  window.__PREVIEW_MODULES__ = mockModules;
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <ScopeProvider>
        <VerifiedDomain />
      </ScopeProvider>
    </QueryClientProvider>
  );
}
