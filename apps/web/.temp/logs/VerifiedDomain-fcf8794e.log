import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import * as SettingsSection from 'components/SettingsSection';
import toast from 'react-hot-toast';

// Create contexts for our mocked data
const CurrentOrgContext = React.createContext(null);
const CurrentUserContext = React.createContext(null);
const ViewerAdminContext = React.createContext(null);
const UpdateOrgContext = React.createContext(null);

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create custom hook implementations
export function useGetCurrentOrganization() {
  return { data: mockCurrentOrg };
}

export function useGetCurrentUser() {
  return { data: mockCurrentUser };
}

export function useViewerIsAdmin() {
  return true;
}

export function useUpdateOrganization() {
  return {
    mutate: (data: any, options: any) => {
      if (options.onSuccess) {
        options.onSuccess();
      }
    },
    isPending: false,
  };
}

// Wrapper component that provides all the necessary context
function MockProvider({ children }: { children: React.ReactNode }) {
  return (
    <CurrentOrgContext.Provider value={useGetCurrentOrganization()}>
      <CurrentUserContext.Provider value={useGetCurrentUser()}>
        <ViewerAdminContext.Provider value={useViewerIsAdmin()}>
          <UpdateOrgContext.Provider value={useUpdateOrganization()}>
            {children}
          </UpdateOrgContext.Provider>
        </ViewerAdminContext.Provider>
      </CurrentUserContext.Provider>
    </CurrentOrgContext.Provider>
  );
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <MockProvider>
      <VerifiedDomain />
    </MockProvider>
  );
}
