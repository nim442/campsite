<change>
<description>Use HOC pattern to inject mocked hooks</description>
<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import * as SettingsSection from 'components/SettingsSection';
import toast from 'react-hot-toast';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a new QueryClient
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create a context for our mocked hooks
const MockContext = React.createContext({
  useGetCurrentOrganization: () => ({ data: mockCurrentOrg }),
  useGetCurrentUser: () => ({ data: mockCurrentUser }),
  useViewerIsAdmin: () => true,
  useUpdateOrganization: () => ({
    mutate: async (data: any, options: any) => {
      if (options?.onSuccess) {
        options.onSuccess();
      }
    },
    isPending: false,
  }),
  useScope: () => ({ scope: 'test-org', setScope: () => {} })
});

// HOC to inject mocked hooks
const withMockHooks = (WrappedComponent: React.ComponentType) => {
  return function WithMockHooksComponent(props: any) {
    const mockHooks = React.useContext(MockContext);
    
    // Override the hooks in the component's context
    const MockedComponent = React.useMemo(() => {
      const originalUseGetCurrentOrganization = require('@/hooks/useGetCurrentOrganization').useGetCurrentOrganization;
      const originalUseGetCurrentUser = require('@/hooks/useGetCurrentUser').useGetCurrentUser;
      const originalUseViewerIsAdmin = require('@/hooks/useViewerIsAdmin').useViewerIsAdmin;
      const originalUseUpdateOrganization = require('hooks/useUpdateOrganization').useUpdateOrganization;
      const originalUseScope = require('@/contexts/scope').useScope;

      require('@/hooks/useGetCurrentOrganization').useGetCurrentOrganization = mockHooks.useGetCurrentOrganization;
      require('@/hooks/useGetCurrentUser').useGetCurrentUser = mockHooks.useGetCurrentUser;
      require('@/hooks/useViewerIsAdmin').useViewerIsAdmin = mockHooks.useViewerIsAdmin;
      require('hooks/useUpdateOrganization').useUpdateOrganization = mockHooks.useUpdateOrganization;
      require('@/contexts/scope').useScope = mockHooks.useScope;

      return <WrappedComponent {...props} />;
    }, [props]);

    return MockedComponent;
  };
};

const MockedVerifiedDomain = withMockHooks(VerifiedDomain);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  return (
    <QueryClientProvider client={queryClient}>
      <MockContext.Provider value={{
        useGetCurrentOrganization: () => ({ data: mockCurrentOrg }),
        useGetCurrentUser: () => ({ data: mockCurrentUser }),
        useViewerIsAdmin: () => true,
        useUpdateOrganization: () => ({
          mutate: async (data: any, options: any) => {
            if (options?.onSuccess) {
              options.onSuccess();
            }
          },
          isPending: false,
        }),
        useScope: () => ({ scope: 'test-org', setScope: () => {} })
      }}>
        <MockedVerifiedDomain />
      </MockContext.Provider>
    </QueryClientProvider>
  );
}
</content>
</change>
