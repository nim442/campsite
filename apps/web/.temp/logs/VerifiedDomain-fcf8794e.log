import React from 'react';
import { useParentState } from '../useIframeState';
import { VerifiedDomain } from '../../components/OrgSettings/VerifiedDomain';
import * as SettingsSection from 'components/SettingsSection';
import toast from 'react-hot-toast';
import { ScopeProvider } from '@/contexts/scope';

// Mock data
const mockCurrentOrg = {
  email_domain: 'example.com',
};

const mockCurrentUser = {
  email: 'user@example.com',
};

// Create custom hook implementations
export function useGetCurrentOrganization() {
  return { data: mockCurrentOrg };
}

export function useGetCurrentUser() {
  return { data: mockCurrentUser };
}

export function useViewerIsAdmin() {
  return true;
}

export function useUpdateOrganization() {
  return {
    mutate: (data: any, options: any) => {
      if (options.onSuccess) {
        options.onSuccess();
      }
    },
    isPending: false,
  };
}

// Mock Next.js router
const mockRouter = {
  query: { org: 'test-org' },
  asPath: '/test-org/settings',
  isReady: true,
};

// Mock the Next.js useRouter hook
jest.mock('next/router', () => ({
  useRouter: () => mockRouter,
}));

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    emailDomain: {
      type: "string",
      value: "example.com",
      label: "Email Domain",
    },
    isAdmin: {
      type: "boolean",
      value: true,
      label: "Is Admin",
    },
  });

  // Create a custom ScopeProvider wrapper that doesn't depend on Next.js router
  const CustomScopeProvider = ({ children }: { children: React.ReactNode }) => {
    const [scope, setScope] = React.useState('test-org');
    const value = React.useMemo(() => ({
      scope,
      setScope: (newScope: string) => setScope(newScope)
    }), [scope]);

    return (
      <ScopeContext.Provider value={value}>
        {children}
      </ScopeContext.Provider>
    );
  };

  return (
    <CustomScopeProvider>
      <VerifiedDomain />
    </CustomScopeProvider>
  );
}
</content>
</change>
