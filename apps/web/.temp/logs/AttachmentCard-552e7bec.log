<description>Create a preview-specific Image component that uses a regular img tag for previews</description>
<content>
import React from 'react';
import Image from 'next/image';

type ImageProps = React.ComponentProps<typeof Image>;

export function PreviewImage(props: ImageProps) {
  const { src, alt, width, height, className, style, draggable } = props;
  
  return (
    <img 
      src={src as string}
      alt={alt}
      width={width}
      height={height}
      className={className}
      style={style}
      draggable={draggable}
    />
  );
}
</content>
</change>
</file>

