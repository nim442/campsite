        run: () => {}
      })
    }),
    commands: {
      unsetNewComment: () => {}
    },
    schema: {}
  } as unknown as Editor;

  const activeComment = state.hasActiveComment.value ? {
    id: state.commentId.value,
    newCommentRange: state.hasNewCommentRange.value ? {
      from: 0,
      to: 10
    } : undefined
  } : null;

  return (
