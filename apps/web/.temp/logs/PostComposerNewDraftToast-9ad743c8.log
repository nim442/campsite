<content>
import React from 'react';
import { useParentState } from '../useIframeState';
import { PostComposerNewDraftToast } from '../../components/PostComposer/PostComposerNewDraftToast';
import { ScopeProvider } from '@/contexts/scope';
import { RouterContext } from 'next/dist/shared/lib/router-context';

// Mock router object with required methods
const mockRouter = {
  route: '/',
  pathname: '/',
  query: {},
  asPath: '/',
  basePath: '',
  isLocaleDomain: false,
  push: () => Promise.resolve(true),
  replace: () => Promise.resolve(true),
  reload: () => {},
  back: () => {},
  prefetch: () => Promise.resolve(),
  beforePopState: () => {},
  events: {
    on: () => {},
    off: () => {},
    emit: () => {},
  },
  isFallback: false,
  isReady: true,
  isPreview: false,
};

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    scope: {
      type: "string",
      value: "team",
      label: "Scope"
    }
  });

  return (
    <RouterContext.Provider value={mockRouter}>
      <ScopeProvider initialScope={state.scope.value}>
        <PostComposerNewDraftToast />
      </ScopeProvider>
    </RouterContext.Provider>
  );
}
</content>
</change>
</file>

This change:
1. Adds a RouterContext.Provider from Next.js
2. Creates a mock router object with all necessary methods and properties
3. Wraps the component with the RouterContext.Provider

The mock router provides all the necessary methods that the component needs, including the `prefetch` method that was causing the error. This should allow the component to render properly in the preview environment while maintaining its original functionality and appearance.

Note that we're not modifying the original component at all - we're just providing the necessary context it needs to function properly in the preview environment. This ensures the component preview looks and behaves exactly as it does in the main application.

