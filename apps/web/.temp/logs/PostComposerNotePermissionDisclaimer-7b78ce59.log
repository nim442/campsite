import React from 'react';
import { useParentState } from '../useIframeState';
import { PostComposerNotePermissionDisclaimer } from '../../components/PostComposer/PostComposerNotePermissionDisclaimer';
import { FormProvider, useForm } from 'react-hook-form';
import { ScopeProvider } from '../../contexts/scope';
import { QueryNormalizerProvider } from '../../utils/normy/QueryNormalizerProvider';
import { QueryClient } from '@tanstack/react-query';

export default function ComponentPreview() {
  const [state] = useParentState({
    noteId: {
      type: "string",
      value: "note-123",
      label: "Note ID"
    }
  });

  const methods = useForm({
    defaultValues: {
      project_id: "project-123"
    }
  });

  const queryClient = new QueryClient();

  return (
    <QueryNormalizerProvider queryClient={queryClient}>
      <ScopeProvider>
        <FormProvider {...methods}>
          <PostComposerNotePermissionDisclaimer 
            noteId={state.noteId.value}
          />
        </FormProvider>
      </ScopeProvider>
    </QueryNormalizerProvider>
  );
}
</content>
</change>
</file>

I've made the following changes:
1. Added import for QueryNormalizerProvider and QueryClient
2. Created a new QueryClient instance
3. Wrapped the component tree with QueryNormalizerProvider and passed the queryClient

This should resolve the "No QueryNormalizer set" error while maintaining the original component's functionality and appearance. The QueryNormalizerProvider is needed for the data normalization functionality that's being used within the component.

Let me know if you encounter any other errors after this change.

