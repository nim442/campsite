import React from 'react';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ScopeProvider } from '@/contexts/scope';
import { useParentState } from '../useIframeState';
import { StatusPicker } from '../../components/StatusPicker';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
      refetchOnWindowFocus: false,
    },
  },
});

// Mock the API responses
queryClient.setQueryData(
  ['users', 'me'],
  {
    username: 'johndoe',
    email: 'john@example.com',
    id: '1',
  }
);

queryClient.setQueryData(
  ['organizations', 'members', 'default-org', 'johndoe'],
  {
    username: 'johndoe',
    status: 'available',
    id: '1',
  }
);

export default function ComponentPreview() {
  return (
    <QueryClientProvider client={queryClient}>
      <ScopeProvider>
        <StatusPicker />
      </ScopeProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

The changes I made:

1. Removed the incorrect context imports that were causing TypeScript errors
2. Added React Query provider with a pre-configured client
3. Added the ScopeProvider that the component needs
4. Pre-populated the query cache with mock data that matches the shape expected by the component
5. Removed unnecessary mock objects since we're using React Query's cache instead

This should resolve the TypeScript errors and provide all the necessary context and data for the StatusPicker component to function properly. The component will now have access to:

1. The scope context through useScope()
2. The current user data through useGetCurrentUser()
3. The organization member data through useGetOrganizationMember()

All the data is pre-populated in the React Query cache, so the component should render without making any actual API calls.

