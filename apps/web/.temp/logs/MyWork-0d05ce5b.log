        >
          <Provider>
            <ScopeProvider>
              <div className="w-full h-full">
                <MyWork />
              </div>
            </ScopeProvider>
          </Provider>
        </QueryNormalizerProvider>
      </QueryClientProvider>
    </RouterProvider>
  );
}

// Override the useRouter hook
