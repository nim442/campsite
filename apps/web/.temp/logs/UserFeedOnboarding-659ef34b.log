import React from 'react';
import { useParentState } from '../useIframeState';
import { UserFeedOnboarding } from '../../components/Onboarding/UserFeedOnboarding';

// Create mock contexts
const ScopeContext = React.createContext<{
  scope: string;
  setScope: (scope: string) => void;
}>({
  scope: 'test-org',
  setScope: () => {}
});

// Mock the router context
const RouterContext = React.createContext({
  query: { org: 'test-org' },
  asPath: '/test-org/dashboard',
  isReady: true
});

// Create Provider components
const MockScopeProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [scope, setScope] = React.useState('test-org');
  
  const value = React.useMemo(() => ({
    scope,
    setScope
  }), [scope]);

  return (
    <ScopeContext.Provider value={value}>
      {children}
    </ScopeContext.Provider>
  );
};

// Mock hooks
export function useScope() {
  return React.useContext(ScopeContext);
}

export function useRouter() {
  return React.useContext(RouterContext);
}

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isOpen: {
      type: "boolean",
      value: true,
      label: "Is Open"
    }
  });

