import React from 'react';
import { useParentState } from '../useIframeState';
import { UserFeedOnboarding } from '../../components/Onboarding/UserFeedOnboarding';

// Create mock contexts
const IsPWAContext = React.createContext(false);
const UpdatePreferenceContext = React.createContext({ mutate: () => {} });
const CurrentUserContext = React.createContext({
  data: {
    preferences: {
      feature_tip_onboard_install_apps: 'false'
    }
  }
});
const CurrentOrganizationContext = React.createContext({
  data: {
    viewer_is_admin: false
  }
});

// Mock the hooks
export function useIsPWA() {
  return React.useContext(IsPWAContext);
}

export function useUpdatePreference() {
  return React.useContext(UpdatePreferenceContext);
}

export function useGetCurrentUser() {
  return React.useContext(CurrentUserContext);
}

export function useGetCurrentOrganization() {
  return React.useContext(CurrentOrganizationContext);
}

// Override the module imports
const mockModules = {
  '@/hooks/useIsPWA': { useIsPWA },
  '@/hooks/useUpdatePreference': { useUpdatePreference },
  '@/hooks/useGetCurrentUser': { useGetCurrentUser },
  '@/hooks/useGetCurrentOrganization': { useGetCurrentOrganization }
};

// Add to window to make it available
window.__mocks = mockModules;

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isOpen: {
      type: "boolean",
      value: true,
      label: "Is Open"
    }
  });

  return (
    <IsPWAContext.Provider value={false}>
      <UpdatePreferenceContext.Provider value={{ mutate: () => {} }}>
        <CurrentUserContext.Provider value={{
          data: {
            preferences: {
              feature_tip_onboard_install_apps: 'false'
            }
          }
        }}>
          <CurrentOrganizationContext.Provider value={{
            data: {
              viewer_is_admin: false
            }
          }}>
            <UserFeedOnboarding />
          </CurrentOrganizationContext.Provider>
        </CurrentUserContext.Provider>
      </UpdatePreferenceContext.Provider>
    </IsPWAContext.Provider>
  );
}
</content>
  </change>
</file>

