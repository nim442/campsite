import React from 'react';
import { useParentState } from '../useIframeState';
import dynamic from 'next/dynamic';

// Create mock data
const mockRouter = {
  query: { callRoomId: '123', im: '' },
  pathname: '/call/123',
  replace: () => {}
};

const mockCallRoom = {
  data: {
    viewer_can_invite_participants: true
  }
};

// Create a dynamic import wrapper that provides mock data
const DynamicInviteParticipantsPopover = dynamic(
  () => import('../../components/Call/InviteParticipantsPopover').then(mod => {
    // Return a wrapped version of the component
    return function WrappedComponent(props: any) {
      return <mod.InviteParticipantsPopover {...props} />;
    };
  }),
  {
    ssr: false,
    loading: () => <div>Loading...</div>
  }
);

// Create the preview component
export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isOpen: {
      type: "boolean",
      value: false,
      label: "Popover Open"
    }
  });

  // Provide the mock data through props
  return (
    <div className="p-4">
      <DynamicInviteParticipantsPopover
        __mockData={{
          router: mockRouter,
          callRoom: mockCallRoom,
          isOrganizationMember: true
        }}
      />
    </div>
  );
}

// Mock the required hooks
if (typeof window !== 'undefined') {
  window.require = (module: string) => {
    switch (module) {
      case 'next/router':
        return { useRouter: () => mockRouter };
      case '@/hooks/useGetCallRoom':
        return { useGetCallRoom: () => mockCallRoom };
      case '@/hooks/useIsOrganizationMember':
        return { useIsOrganizationMember: () => true };
      default:
        return {};
    }
  };
}
</content>
</change>
</file>

