import React from 'react';
import { useParentState } from '../useIframeState';
import { InviteParticipantsPopover } from '../../components/Call/InviteParticipantsPopover';

// Create HOC to provide mock data
const withMockData = (WrappedComponent: typeof InviteParticipantsPopover) => {
  return function WithMockData(props: any) {
    // Mock the router data
    const router = {
      query: { callRoomId: '123', im: '' },
      pathname: '/call/123',
      replace: () => {}
    };

    // Mock the call room data
    const callRoom = {
      data: {
        viewer_can_invite_participants: true
      }
    };

    // Override the modules using React's component composition
    const MockedComponent = () => {
      return <WrappedComponent {...props} />;
    };

    // Attach the mocked hooks to the component
    (MockedComponent as any).useRouter = () => router;
    (MockedComponent as any).useGetCallRoom = () => callRoom;
    (MockedComponent as any).useIsOrganizationMember = () => true;

    return <MockedComponent />;
  };
};

// Create the mocked component
const MockedInviteParticipantsPopover = withMockData(InviteParticipantsPopover);

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    isOpen: {
      type: "boolean",
      value: false,
      label: "Popover Open"
    }
  });

  return (
    <div className="p-4">
      <MockedInviteParticipantsPopover />
    </div>
  );
}

// Mock the modules at the top level
const mockRouter = {
  query: { callRoomId: '123', im: '' },
  pathname: '/call/123',
  replace: () => {}
};

// Create proxy objects for the hooks
const nextRouter = new Proxy({}, {
  get: (target, prop) => {
    if (prop === 'useRouter') {
      return () => mockRouter;
    }
    return target[prop];
  }
});

const useGetCallRoomProxy = new Proxy({}, {
  get: (target, prop) => {
    if (prop === 'useGetCallRoom') {
      return () => ({
        data: {
          viewer_can_invite_participants: true
        }
      });
    }
    return target[prop];
  }
});

const useIsOrganizationMemberProxy = new Proxy({}, {
  get: (target, prop) => {
    if (prop === 'useIsOrganizationMember') {
      return () => true;
    }
    return target[prop];
  }
});

// Override the imports using proxies
(globalThis as any).nextRouter = nextRouter;
(globalThis as any).useGetCallRoom = useGetCallRoomProxy;
(globalThis as any).useIsOrganizationMember = useIsOrganizationMemberProxy;
