import React from 'react';
import { useParentState } from '../useIframeState';
import { AppLayout } from '../../components/Layout/AppLayout';
import { ScopeProvider } from '../../contexts/scope';
import { useRouter } from 'next/router';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';

// Create a client
const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      retry: false,
    },
  },
});

// Mock Next.js router for the preview
const MockRouter = () => {
  const router = useRouter();
  return {
    ...router,
    query: { org: 'test-org' },
    isReady: true,
    asPath: '/test-org/inbox'
  };
};

// Mock useRouter to return our mock data
jest.mock('next/router', () => ({
  useRouter: () => MockRouter()
}));

// Prefetch the current user data
queryClient.setQueryData(['users', 'me'], {
  logged_in: true,
  // Add other necessary user data fields
});

export default function ComponentPreview() {
  return (
    <QueryClientProvider client={queryClient}>
      <ScopeProvider>
        <AppLayout>
          <div className="p-4">
            Sample content for the layout
          </div>
        </AppLayout>
      </ScopeProvider>
    </QueryClientProvider>
  );
}
</content>
</change>
</file>

