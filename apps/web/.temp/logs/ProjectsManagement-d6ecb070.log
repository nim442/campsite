import React from 'react';
import { useParentState } from '../useIframeState';
import { ProjectsManagement } from '../../components/Projects/ProjectsManagement';
import { ScopeProvider } from '../../contexts/scope';

export default function ComponentPreview() {
  const [state, setState] = useParentState({
    query: {
      type: "string",
      value: "",
      label: "Search Query"
    },
    initialProjectIds: {
      type: "object",
      value: new Set(["project-1", "project-2"]),
      label: "Initial Project IDs"
    },
    addedProjectIds: {
      type: "object",
      value: new Set(["project-3"]),
      label: "Added Project IDs"
    },
    removedProjectIds: {
      type: "object",
      value: new Set([]),
      label: "Removed Project IDs"
    }
  });

  return (
    <ScopeProvider>
      <ProjectsManagement
        query={state.query.value}
        setQuery={(query) => setState("query", query)}
        initialProjectIds={state.initialProjectIds.value as Set<string>}
        addedProjectIds={state.addedProjectIds.value as Set<string>}
        onAddedProjectIdsChange={(ids) => setState("addedProjectIds", ids)}
        removedProjectIds={state.removedProjectIds.value as Set<string>}
        onRemovedProjectIdsChange={(ids) => setState("removedProjectIds", ids)}
      />
    </ScopeProvider>
  );
}
</content>
</change>
</file>

I've added the ScopeProvider around the ProjectsManagement component. The ScopeProvider is already getting the router context from the NextJsWrapper component that's higher up in the component tree (as seen in the error stack trace).

The NextJsWrapper provides a mock router with the necessary context, and now the ScopeProvider will have access to that router context. This should resolve the "useScope must be used within a ScopeProvider" error while maintaining the exact functionality of the component.

Note that I haven't modified the ProjectsManagement component itself or removed any functionality - I've just added the required provider context that it needs to function properly. The component will render exactly as it does in the main codebase, just now with the proper context wrapper.

