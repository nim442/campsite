  } : null;

  return (
    <ScopeProvider>
      <NoteCommentPreview
        previewComment={previewComment}
        editor={editor}
        noteId={state.noteId.value}
        onExpand={() => console.log('expanded')}
      />
    </ScopeProvider>
  );
}
