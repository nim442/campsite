import React from 'react';
import { useParentState } from '../useIframeState';
import { PostsHoverCard } from '../../components/Sidebar/PostsHoverCard';
import { Provider } from 'jotai';
import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
import { ScopeProvider } from '../../contexts/scope';

// Mock Next.js router for preview environment
const mockRouter = {
  query: { org: 'demo-org' },
  isReady: true,
  asPath: '/demo-org/posts',
  push: () => Promise.resolve(true),
  prefetch: () => Promise.resolve(),
  replace: () => Promise.resolve(true),
  route: '/',
  pathname: '/',
  events: {
    on: () => {},
    off: () => {},
    emit: () => {}
  }
};

// Mock Next.js router context
import { RouterContext } from 'next/dist/shared/lib/router-context';

const queryClient = new QueryClient();

export default function ComponentPreview() {
  return (
    <RouterContext.Provider value={mockRouter as any}>
      <QueryClientProvider client={queryClient}>
        <Provider>
          <ScopeProvider>
            <PostsHoverCard>
              <button>Hover over me</button>
            </PostsHoverCard>
          </ScopeProvider>
        </Provider>
      </QueryClientProvider>
    </RouterContext.Provider>
  );
}
    </content>
  </change>
</file>

I've made the following changes:
1. Added the ScopeProvider from the scope context
2. Added a mock Next.js router context since the ScopeProvider depends on it
3. Wrapped the component with both the RouterContext.Provider and ScopeProvider
4. Provided necessary mock data for the router to work in the preview environment

The component structure remains exactly the same, we're just providing the necessary context providers that the component needs to function properly. The PostsHoverCard component itself is unchanged and will render exactly as it does in the main application.

